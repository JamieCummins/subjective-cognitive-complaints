group_by(unique_id) %>%
fill(prolificid, .direction = "down") %>%
mutate(session_start_timestamp = ifelse(row_number() == 1, as.character(timestamp), NA)) %>%
fill(session_start_timestamp) %>%
ungroup() %>%
rename(email = prolificid) %>%
mutate(email = str_trim(tolower(email)),
timepoint = 1)
