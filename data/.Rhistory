# create full raw dfs
## PPVT
ppvt_raw_df <- ppvt_t1_raw_df
# %>%
#   bind_rows(ppvt_t2_raw_df)
## SPM
spm_raw_df <- spm_t1_raw_df
# %>%
#   bind_rows(spm_t2_raw_df)
## RAI
rai_raw_df <- rai_t1_raw_df
# %>%
#   bind_rows(rai_t2_raw_df)
# read in condition df
# conditions_df <- read_csv("conditions.csv")
# view participant data
df <- read_csv("raw/data.csv") %>%
summarise(max = max(stage, na.rm = TRUE))
demographics_df <- rai_t1_raw_df %>%
select(email, age, gender = wat_is_uw_geslacht) %>%
filter(!is.na(age)) %>%
distinct(email, .keep_all = TRUE) %>%
mutate(gender = tolower(str_sub(gender, start = 1, end = 1)),
gender = case_when(gender == "m" ~ "male",
gender == "v" ~ "female",
TRUE ~ "NA"))
# Some participants attempted the task more than once because it crashed on their first time.
# Let's identify the sessions where 60 trials were completed and only include those.
# unique_id can be used as a proxy for specific session ID
# we export those unique_ids into a vector, then use that vector to keep only those IDs
complete_spm_sessions <- spm_raw_df %>%
filter(!is.na(main_image)) %>%
group_by(unique_id, timepoint) %>%
filter(n() == 60) %>%
ungroup() %>%
# in cases where two complete sessions were present, arrange by date and keep only the first
group_by(email, timepoint) %>%
arrange(session_start_timestamp) %>%
do(head(., 60)) %>%
ungroup() %>%
distinct(unique_id) %>%
as_vector()
## Identify if there are participants for whom there are only T2 data -
## would indicate some issue with IDs
t1_spm_data <- spm_raw_df %>%
filter(!is.na(main_image),
unique_id %in% complete_spm_sessions) %>%
distinct(email, timepoint) %>%
filter(timepoint == 1) %>%
pull(email)
# Some participants attempted the task more than once because it crashed on their first time.
# Let's identify the sessions where 60 trials were completed and only include those.
# unique_id can be used as a proxy for specific session ID
# we export those unique_ids into a vector, then use that vector to keep only those IDs
complete_ppvt_sessions <- ppvt_raw_df %>%
filter(correct != "NA") %>%
group_by(unique_id, timepoint) %>%
filter(n() == 60) %>%
ungroup() %>%
# in cases where two complete sessions were present, arrange by date and keep only the first
group_by(email, timepoint) %>%
arrange(session_start_timestamp) %>%
do(head(., 60)) %>%
ungroup() %>%
distinct(unique_id) %>%
as_vector()
## Identify if there are participants for whom there are only T2 data -
## would indicate some issue with IDs
t1_ppvt_data <- ppvt_raw_df %>%
filter(correct != "NA",
unique_id %in% complete_ppvt_sessions) %>%
distinct(email, timepoint) %>%
filter(timepoint == 1) %>%
pull(email)
# Some participants attempted the task more than once because it crashed on their first time.
# Let's identify the sessions where 60 trials were completed and only include those.
# unique_id can be used as a proxy for specific session ID
# we export those unique_ids into a vector, then use that vector to keep only those IDs
complete_rai_sessions <- rai_raw_df %>%
filter(trial_num != "NA") %>%
group_by(unique_id, timepoint) %>%
distinct(trial_num, timepoint, .keep_all = TRUE) %>%
filter(n() == 128) %>%
ungroup() %>%
# in cases where two complete sessions were present, arrange by date and keep only the first
group_by(email, timepoint) %>%
arrange(session_start_timestamp) %>%
do(head(., 128)) %>%
ungroup() %>%
distinct(unique_id) %>%
as_vector()
## Identify if there are participants for whom there are only T2 data -
## would indicate some issue with IDs
t1_rai_data <- rai_raw_df %>%
filter(trial_num != "NA",
unique_id %in% complete_rai_sessions) %>%
distinct(email, timepoint) %>%
filter(timepoint == 1) %>%
pull(email)
# process Raven's Matrices
fluid_iq_df <- spm_raw_df %>%
filter(unique_id %in% complete_spm_sessions,
!is.na(correct_answer)) %>%
mutate(correct = case_when(correct_answer == response ~ 1,
TRUE ~ 0)) %>%
group_by(email, timepoint) %>%
summarise(ravens_raw_score = sum(correct),
ravens_duration_minutes = sum(duration) / (1000 * 60)) %>%
ungroup() %>%
mutate(fluid_iq = case_when(ravens_raw_score < 21 ~ 65,
ravens_raw_score > 20 & ravens_raw_score < 25 ~ 66,
ravens_raw_score == 25 ~ 67,
ravens_raw_score == 26 ~ 68,
ravens_raw_score == 27 ~ 69,
ravens_raw_score == 28 ~ 70,
ravens_raw_score == 29 ~ 70,
ravens_raw_score == 30 ~ 71,
ravens_raw_score == 31 ~ 74,
ravens_raw_score == 32 ~ 74,
ravens_raw_score == 33 ~ 75,
ravens_raw_score == 34 ~ 76,
ravens_raw_score == 35 ~ 77,
ravens_raw_score == 36 ~ 80,
ravens_raw_score == 37 ~ 82,
ravens_raw_score == 38 ~ 83,
ravens_raw_score == 39 ~ 85,
ravens_raw_score == 40 ~ 87,
ravens_raw_score == 41 ~ 89,
ravens_raw_score == 42 ~ 90,
ravens_raw_score == 43 ~ 91,
ravens_raw_score == 44 ~ 94,
ravens_raw_score == 45 ~ 96,
ravens_raw_score == 46 ~ 98,
ravens_raw_score == 47 ~ 100,
ravens_raw_score == 48 ~ 103,
ravens_raw_score == 49 ~ 104,
ravens_raw_score == 50 ~ 107,
ravens_raw_score == 51 ~ 109,
ravens_raw_score == 52 ~ 111,
ravens_raw_score == 53 ~ 114,
ravens_raw_score == 54 ~ 116,
ravens_raw_score == 55 ~ 120,
ravens_raw_score == 56 ~ 123,
ravens_raw_score == 57 ~ 124,
ravens_raw_score == 58 ~ 127,
ravens_raw_score == 59 ~ 130,
ravens_raw_score == 60 ~ 132)) %>%
# full_join(conditions_df) %>%
# need to do percentile scores properly
mutate(ravens_percentile = round(percent_rank(ravens_raw_score), 2))
spm_complete_data <- fluid_iq_df %>%
group_by(email) %>%
filter(n() == 1) %>%
ungroup() %>%
pull(email)
# Process PPVT
ppvt_calculate_errors <- ppvt_raw_df %>%
filter(unique_id %in% complete_ppvt_sessions) %>%
mutate(correct = case_when(is.na(correct) ~ 0,
TRUE ~ as.numeric(correct))) %>%
group_by(unique_id, email, set_number, timepoint) %>%
summarise(number_of_errors_in_set = 12 - sum(correct, na.rm = TRUE)) %>%
ungroup()
ppvt_break_item <- ppvt_calculate_errors %>%
filter(!is.na(set_number),
number_of_errors_in_set < 9) %>%
group_by(unique_id) %>%
filter(set_number == max(set_number)) %>%
ungroup() %>%
mutate(break_item = set_number * 12) %>%
select(unique_id, break_item)
crystallised_iq_df <- ppvt_calculate_errors %>%
left_join(ppvt_break_item) %>%
group_by(unique_id, email, timepoint) %>%
summarise(total_errors = sum(number_of_errors_in_set),
ppvt_raw_score = break_item - total_errors) %>%
ungroup() %>%
distinct(email, timepoint, ppvt_raw_score) %>%
# full_join(conditions_df) %>%
# need to do percentile scores properly
mutate(ppvt_percentile = round(percent_rank(ppvt_raw_score), 2))
ppvt_complete_data <- crystallised_iq_df %>%
group_by(email) %>%
# filter(n() == 2) %>%
ungroup() %>%
pull(email)
# Process RAI
# get proportion correct and total trials completed
relational_task_trials_df <- rai_raw_df %>%
filter(unique_id %in% complete_rai_sessions) %>%
group_by(email, timepoint) %>%
fill(total_correct) %>%
mutate(total_correct = lead(total_correct)) %>%
ungroup() %>%
filter(sender == "trial" & trial_num != "XXX") %>%
select(email, timepoint, unique_id, correct, block, correct_response, response, duration, total_correct) %>%
group_by(email, timepoint) %>%
mutate(n_trials_completed = n(),
rts_criterion = case_when(quantile(duration, .5) >= 5000 ~ 1,
TRUE ~ 0)) %>%
mutate(trial_type = case_when(block == 1 ~ "opposition",
block == 2 ~ "difference",
block == 3 ~ "quantity",
block == 4 ~ "temporal",
block == 5 ~ "containment",
block == 6 ~ "analogy",
block == 7 ~ "deictic",
block == 8 | block == 9 ~ "mathematical")) %>%
group_by(email, timepoint, trial_type) %>%
mutate(correct = case_when(is.na(as.numeric(correct)) ~ 0,
TRUE ~ as.numeric(correct)),
trial_score = mean(correct)) %>%
ungroup()
# get overall score
relational_task_overall_scores_df <- relational_task_trials_df %>%
arrange(email, timepoint, total_correct) %>%
group_by(email, timepoint) %>%
summarise_all(last) %>%
mutate(relational_score = (total_correct / n_trials_completed)) %>%
ungroup() %>%
select(email, timepoint, relational_score, rts_criterion)
# %>%
#   full_join(conditions_df)
rai_complete_data <- relational_task_overall_scores_df %>%
group_by(email) %>%
# filter(n() == 2) %>%
ungroup() %>%
pull(email)
# get individual trial scores
subscale_scores_df <- relational_task_trials_df %>%
distinct(email, timepoint, trial_type, trial_score) %>%
pivot_wider(names_from = trial_type,
values_from = trial_score)
# %>%
#   full_join(conditions_df)
fsiq_score <- fluid_iq_df %>%
left_join(crystallised_iq_df) %>%
filter(!is.na(ravens_raw_score),
!is.na(ppvt_raw_score)) %>%
group_by(email) %>%
# filter(n() == 2) %>%
group_by(email, timepoint) %>%
mutate(average_percentile = sum(ravens_percentile, ppvt_percentile, na.rm = TRUE) / 2) %>%
ungroup() %>%
mutate(fsiq_estimate = qnorm(average_percentile, mean = 100, sd = 15)) %>%
select(email, timepoint, fsiq_estimate)
group_level_df <- relational_task_overall_scores_df %>%
full_join(fluid_iq_df) %>%
full_join(crystallised_iq_df) %>%
left_join(demographics_df) %>%
left_join(fsiq_score) %>%
mutate(complete_rai = case_when(email %in% rai_complete_data ~ 1,
TRUE ~ 0),
complete_spm = case_when(email %in% spm_complete_data ~ 1,
TRUE ~ 0),
complete_ppvt = case_when(email %in% ppvt_complete_data ~ 1,
TRUE ~ 0),
fluid_iq = as.numeric(fluid_iq),
ppvt_raw_score = as.numeric(ppvt_raw_score),
relational_score = as.numeric(relational_score),
fsiq_estimate = as.numeric(fsiq_estimate)) %>%
select(-rts_criterion, -ravens_duration_minutes, -fluid_iq, -ravens_percentile,
-ppvt_percentile)
subscale_level_df <- subscale_scores_df %>%
full_join(fluid_iq_df) %>%
full_join(crystallised_iq_df) %>%
left_join(demographics_df) %>%
left_join(fsiq_score) %>%
mutate(complete_rai = case_when(email %in% rai_complete_data ~ 1,
TRUE ~ 0),
complete_spm = case_when(email %in% spm_complete_data ~ 1,
TRUE ~ 0),
complete_ppvt = case_when(email %in% ppvt_complete_data ~ 1,
TRUE ~ 0),
fluid_iq = as.numeric(fluid_iq),
ppvt_raw_score = as.numeric(ppvt_raw_score),
fsiq_estimate = as.numeric(fsiq_estimate)) %>%
select(-ravens_duration_minutes, -fluid_iq, -ravens_percentile,
-ppvt_percentile)
# select relevant relations
personalised_proportions <- subscale_level_df %>%
select(email, opposition, quantity, temporal, containment, mathematical) %>%
mutate(across(c("opposition", "temporal", "quantity", "containment", "mathematical"),
~ case_when(. == 0 ~ 0.0625,
. != 0 ~ .)),
overall = opposition + temporal + quantity + containment,
across(c("opposition", "temporal", "quantity", "containment", "mathematical"), ~ 1 / (. / overall)),
inverse_sum = opposition + temporal + quantity + containment + mathematical,
across(c("opposition", "temporal", "quantity", "containment", "mathematical"),
~ round((. / inverse_sum) * n_stages_five_relations), 0)) %>%
select(-overall, -inverse_sum) %>%
# calculate change needed in trials
mutate(opposition = opposition - 24,
quantity = quantity - 25,
temporal = temporal - 25,
containment = containment - 21,
mathematical = mathematical - 18)
