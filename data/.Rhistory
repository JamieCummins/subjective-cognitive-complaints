library(emmeans)
?emmeans
data.frame(participant = rep(c(1:100), each = 20),
timepoint = rep(rep(c(1:2), each = 10), 100),
group = rep(rep(c(1, 2), each = 20), 500))
knitr::opts_chunk$set(echo = TRUE)
baseline_iq <- processed_df %>%
select(ID, baseline_iq = fsiq_t1)
set.seed(1)
library(tidyverse)
library(effsize)
library(car)
library(broom)
library(emmeans)
processed_df <- read_csv("../data/processed/processed.csv")
sample_size <- nrow(processed_df)
processed_df %>%
pivot_longer(cols = c(fsiq_t1, fsiq_t2),
names_to = "timepoint",
values_to = "fsiq") %>%
filter(condition == "SMART" & timepoint == "fsiq_t2" |
condition == "control" & timepoint == "fsiq_t1") %>%
t.test(fsiq ~ condition,
var.equal = TRUE,
data = .)
processed_df %>%
pivot_longer(cols = c(fsiq_t1, fsiq_t2),
names_to = "timepoint",
values_to = "fsiq") %>%
filter(condition == "SMART" & timepoint == "fsiq_t2" |
condition == "control" & timepoint == "fsiq_t1") %>%
cohen.d(fsiq ~ condition,
var.equal = TRUE,
data = .)
processed_df %>%
pivot_longer(cols = c(fsiq_t1, fsiq_t2),
names_to = "timepoint",
values_to = "fsiq") %>%
mutate(timepoint = str_remove(timepoint, "fsiq_"),
timepoint = case_when(timepoint == "t1" ~ "Baseline",
TRUE ~ "Follow-up"),
condition = case_when(condition == "control" ~ "Control",
TRUE ~ condition)) %>%
aov(fsiq ~ timepoint * condition,
data = .) %>%
car::Anova(., type = "III")
processed_df %>%
pivot_longer(cols = c(fsiq_t1, fsiq_t2),
names_to = "timepoint",
values_to = "fsiq") %>%
mutate(timepoint = str_remove(timepoint, "fsiq_"),
timepoint = case_when(timepoint == "t1" ~ "Baseline",
TRUE ~ "Follow-up"),
condition = case_when(condition == "control" ~ "Control",
TRUE ~ condition)) %>%
group_by(timepoint, condition) %>%
summarise(mean_iq = mean(fsiq),
sd = sd(fsiq)) %>%
ggplot(aes(timepoint, mean_iq, group = condition, color = condition)) +
geom_point() +
geom_errorbar(aes(ymin = mean_iq - sd,
ymax = mean_iq + sd))
baseline_iq <- processed_df %>%
select(ID, baseline_iq = fsiq_t1)
processed_df %>%
pivot_longer(cols = c(fsiq_t1, fsiq_t2),
names_to = "timepoint",
values_to = "fsiq") %>%
mutate(timepoint = str_remove(timepoint, "fsiq_"),
timepoint = case_when(timepoint == "t1" ~ "Baseline",
TRUE ~ "Follow-up"),
timepoint = as.factor(timepoint),
condition = case_when(condition == "control" ~ "Control",
TRUE ~ condition),
condition = as.factor(condition)) %>%
left_join(baseline_iq) %>%
aov(fsiq ~ condition + baseline_iq + timepoint + condition:timepoint,
data = .) %>%
car::Anova(., type = "III")
emmeans_baseline_iq <- processed_df %>%
pivot_longer(cols = c(fsiq_t1, fsiq_t2),
names_to = "timepoint",
values_to = "fsiq") %>%
mutate(timepoint = str_remove(timepoint, "fsiq_"),
timepoint = case_when(timepoint == "t1" ~ "Baseline",
TRUE ~ "Follow-up"),
timepoint = as.factor(timepoint),
condition = case_when(condition == "control" ~ "Control",
TRUE ~ condition),
condition = as.factor(condition)) %>%
left_join(baseline_iq) %>%
aov(fsiq ~ condition + baseline_iq + timepoint + condition:timepoint,
data = .) %>%
emmeans(., ~ timepoint | condition)
emmeans_baseline_iq %>%
summary() %>%
rename(Timepoint = timepoint,
IQ = emmean,
Treatment = condition) %>%
ggplot(aes(Timepoint, IQ, color = Treatment, group = Treatment)) +
geom_point(position = position_dodge(width = .5)) +
geom_line(aes(linetype = Treatment),
position = position_dodge(width = .5)) +
geom_errorbar(aes(ymin = lower.CL,
ymax = upper.CL),
position = position_dodge(width = .5)) +
theme_classic() +
scale_color_manual(values = c("black", "grey"))
